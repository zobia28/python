# Task 2: First 8 odd numbers from 15
print("\nFirst 8 odd numbers from 15:")
# Your code here
count = 0
n = 15
while count < 8:
    if n % 2 == 1:
        print(n, end=", ") 
        count += 1
    n += 1
print()  # Creates a new line for better readability

