def verify_card_number(card_number):
    # Step 1: Remove any spaces or dashes from the string
    cleaned_card = card_number.replace(' ', '').replace('-', '')
    
    # Reverse the digits to process from right to left easily
    digits = [int(digit) for digit in cleaned_card[::-1]]
    
    total_sum = 0
    
    # Step 2: Iterate over the digits using index
    for index, digit in enumerate(digits):
        # Every second digit from right to left (index 1, 3, 5, etc.) gets doubled
        if index % 2 == 1:
            doubled_digit = digit * 2
            # If the doubled result is > 9, subtract 9 (same as summing two-char digits)
            if doubled_digit > 9:
                doubled_digit -= 9
            total_sum += doubled_digit
        else:
            total_sum += digit
            
    # Step 3: Check if the sum is a multiple of 10
    if total_sum % 10 == 0:
        return "VALID!"
    else:
        return "INVALID!"
